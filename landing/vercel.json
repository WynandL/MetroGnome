{
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "metro-gnome-gilt.vercel.app" }],
      "destination": "https://metrognome.co.za/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "has": [{ "type": "host", "value": "metro-gnome-gilt.vercel.app" }],
      "destination": "https://metrognome.co.za/blog/",
      "permanent": true
    },
    {
      "source": "/tools/",
      "has": [{ "type": "host", "value": "metro-gnome-gilt.vercel.app" }],
      "destination": "https://metrognome.co.za/tools/",
      "permanent": true
    },
    {
      "source": "/embed/",
      "has": [{ "type": "host", "value": "metro-gnome-gilt.vercel.app" }],
      "destination": "https://metrognome.co.za/embed/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "metro-gnome-gilt.vercel.app" }],
      "destination": "https://metrognome.co.za/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/blog/index.html", "destination": "/blog/", "permanent": true },
    { "source": "/blog", "destination": "/blog/", "permanent": true },
    { "source": "/tools/index.html", "destination": "/tools/", "permanent": true },
    { "source": "/tools", "destination": "/tools/", "permanent": true },
    { "source": "/embed/index.html", "destination": "/embed/", "permanent": true },
    { "source": "/embed", "destination": "/embed/", "permanent": true }
  ]
}
